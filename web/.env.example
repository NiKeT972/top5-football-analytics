# Copy to .env.local for local development. On Vercel, set these as project env vars.

# Supabase (read-only access: publishable key + documented public views only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL (sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://pitchiq.vercel.app

# Shared secret for POST /api/revalidate (also a GitHub Actions secret)
REVALIDATE_SECRET=

# Ask agent
LLM_PROVIDER=google            # google | groq | openai
LLM_MODEL=                     # optional override, e.g. gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=  # free key from Google AI Studio
GROQ_API_KEY=
OPENAI_API_KEY=
ASK_SERVER_TOKEN=              # must equal core.app_secrets.ask_server_token in the database
ASK_DAILY_CAP=300
