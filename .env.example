# Copy to .env (never commit .env). Used by the pipeline and GitHub Actions.

# Supabase Postgres, pipeline writer role (Phase 5)
SUPABASE_DB_URL_WRITER=postgresql://pipeline_writer:CHANGE_ME@HOST:6543/postgres

# Durable history store (Phase 1), e.g. a private Hugging Face dataset
HF_TOKEN=
HF_DATASET_REPO=NiKeT972/pitchiq-data

# Vercel on-demand revalidation (Phase 8)
SITE_URL=https://example.vercel.app
REVALIDATE_SECRET=

# Local paths
PITCHIQ_DATA_DIR=pipeline/data
SOCCERDATA_DIR=pipeline/data/raw/soccerdata
